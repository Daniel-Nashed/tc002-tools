# Build artifacts - regenerated by ./build_all.sh, never committed
/dist/

# Release files - collected by create_release_taz.sh, attached to a GitHub release
/release/

# Disposable build workdirs (source extraction, object files)
/build/work/
/build/work-musl/
*.o
*.a
/components/nshbox/src/nshbox
/components/nshbox/src/nshbox-static
/components/tc002-discover/src/tc002-discover
/tests/nshbox/nshbox_tests
/components/jwt-verify/jwt_verify

# Never commit key material or device-specific data
*.pem
*_key
*_key.pub
authorized_keys
id_ed25519*
*.ovpn
config/tc002-tools.conf

# Editor / OS noise
.DS_Store
*.swp
*~
