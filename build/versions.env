# Central place for every pinned build input in tc002-tools: container base
# images, the cross-toolchain source revision, and each upstream source with
# its SHA-256.
#
# Plain KEY="value" assignments only (no shell logic): sourced by build/common.sh
# (and so by every build script), and read by the three docker-*/run.sh scripts,
# which pass the container versions to "docker build" as --build-arg. To bump a
# version, edit it here (for an upstream source, the VERSION and its SHA256
# together) and rebuild. The reasons behind individual pins (why 3.6 and not
# 4.x for mbedTLS, why nginx Mainline, ...) are in each component's
# build/build_<name>.sh and README.md. See docs/build_platform.md for the
# overview table.

# --- Container base images (build/docker-*/Dockerfile) ---
# The ARM build image and the native Alpine image share one Alpine version.
ALPINE_VERSION="3.22.4"
UBUNTU_VERSION="26.04"

# --- Cross toolchain (build/docker-alpine-arm/Dockerfile) ---
# musl-cross-make commit. It decides the GCC, musl, binutils, gmp, mpfr, mpc and
# Linux-headers versions. Latest master when pinned (2026-09-25, its 2026-06-16
# commit "musl security patches" - CVE-2026-40200/CVE-2026-6042). Check with:
#   git ls-remote https://github.com/richfelker/musl-cross-make HEAD
# Bumping it changes the compiler and musl versions: rebuild and retest everything.
MCM_COMMIT="227df8b99103f9c59f6570babf892978e293082f"

# --- Upstream sources (each script downloads and verifies these) ---
DROPBEAR_VERSION="2026.94"
DROPBEAR_SHA256="e098034a843699200c8c977a991fff73159735bf795d5f72ef672c41a6b1ae81"
GZIP_VERSION="1.14"
GZIP_SHA256="613d6ea44f1248d7370c7ccdeee0dd0017a09e6c39de894b3c6f03f981191c6b"
NCDU_VERSION="1.22"
NCDU_SHA256="0ad6c096dc04d5120581104760c01b8f4e97d4191d6c9ef79654fa3c691a176b"
MBEDTLS_VERSION="3.6.7"
MBEDTLS_SHA256="a7e8bcbec0e6f761b4af24f25677626b35f762f68eef79c08677a363212d11f6"
CURL_VERSION="8.22.0"
CURL_SHA256="d54dd598bf05927a726deb38df31c6a255ba83ff1de57c5d1464dac3ed8f44a1"
OPENSSL_VERSION="4.0.2"
OPENSSL_SHA256="736b467530f916737b7031310ccb21d8218c6229e61e8e160cd1d3458cd543a8"
NGINX_VERSION="1.31.6"
NGINX_SHA256="974ed5298a5e398e008704ed5db284e655fc270c596493dbccada452448fc9f1"
SEVENZIP_VERSION="26.03"
SEVENZIP_SHA256="9cbde5099c6deb73691b0579063da5827522ccbbcba3f0020fd04e8c8c16c0d4"
